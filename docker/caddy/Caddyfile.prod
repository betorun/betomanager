# Entrée HTTPS de la production (docker-compose.prod.yaml). Hôtes par variables,
# voir .env.prod.example. Keycloak, Temporal, Postgres, Redis et le stockage
# objet n'ont volontairement aucune route ici.
{
	email {$ACME_EMAIL}

	servers {
		# Seule la console (BFF, IP fixe) peut transmettre l'adresse de son
		# client. Tout autre X-Forwarded-For entrant est écrasé par Caddy.
		trusted_proxies static {$CONSOLE_INTERNAL_IP}/32
	}
}

(compress) {
	encode zstd gzip
}

(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

# Console
{$CONSOLE_HOST} {
	import compress
	import hsts
	reverse_proxy console:3000
}

# API
{$API_HOST} {
	import hsts

	# Sondes et métriques : jamais publiques.
	@private path /metrics /metrics/* /api/v1/ready /healthz /readyz
	handle @private {
		respond 404
	}

	# Flux de journaux (HTTP chunked) : ni compressés, ni retenus. La
	# compression les ferait attendre sur une connexion lente.
	@stream path_regexp ^/kmanager/v1/.*/logs$
	handle @stream {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle {
		import compress
		reverse_proxy api:8080
	}
}

# Registre d'images : pas de compression (couches déjà compressées), pas de
# plafond ici, envois longs.
{$REGISTRY_HOST} {
	import hsts
	reverse_proxy registry:5000 {
		flush_interval -1
	}
}

# Temps réel : uniquement le WebSocket client. L'API HTTP de Centrifugo reste
# interne. Centrifugo gère sa propre compression.
{$REALTIME_HOST} {
	import hsts
	handle /connection/* {
		reverse_proxy centrifugo:8000
	}
	handle {
		respond 404
	}
}

# Stockage objet.
#  - Buckets des clients (bt- + 12 caractères, ADR 0015) : tout le S3, depuis
#    partout (conteneurs, outils, CI, liens signés, lecture publique). La
#    barrière est la clé, limitée à un seul bucket, ou la lecture publique
#    ouverte par le propriétaire. Adresses en style chemin : <hôte>/<bucket>/…
#  - Stockage des sites, pour static-edge qui tourne dans le cluster (serveur
#    2) : lectures seules depuis le serveur 2, identité « edge ».
#  - Tout le reste (liste des buckets, API IAM sur POST /, buckets de la
#    plateforme) : refusé depuis l'extérieur.
{$S3_PUBLIC_HOST} {
	import hsts
	@clients path_regexp ^/bt-[a-z0-9]{12}(/.*)?$
	handle @clients {
		reverse_proxy seaweedfs:8333 {
			flush_interval -1
		}
	}
	@cluster {
		remote_ip {$SERVER2_IP}
		method GET HEAD
	}
	handle @cluster {
		reverse_proxy seaweedfs:8333 {
			flush_interval -1
		}
	}
	handle {
		respond 403
	}
}
